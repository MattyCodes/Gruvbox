{
  "manifest_version": 3,
  "name": "Gruvbox Dark",
  "version": "1.0.0",
  "description": "Gruvbox (medium) dark colour scheme for the Chrome / Brave browser UI. Static companion to the Gruvbox Firefox theme switcher.",
  "icons": { "128": "icon.png" },
  "theme": {
    "colors": {
      "frame": [29, 32, 33],
      "frame_inactive": [29, 32, 33],
      "frame_incognito": [29, 32, 33],
      "frame_incognito_inactive": [29, 32, 33],
      "toolbar": [40, 40, 40],
      "tab_text": [251, 241, 199],
      "tab_background_text": [168, 153, 132],
      "tab_background_text_inactive": [146, 131, 116],
      "bookmark_text": [235, 219, 178],
      "omnibox_background": [29, 32, 33],
      "omnibox_text": [235, 219, 178],
      "ntp_background": [40, 40, 40],
      "ntp_text": [235, 219, 178],
      "ntp_link": [131, 165, 152]
    },
    "tints": {
      "buttons": [-1, -1, 0.9]
    },
    "properties": {
      "ntp_logo_alternate": 1
    }
  }
}
